FROM node:22-slim
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui ./
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_NODUS_ACCOUNTS=off
ENV NEXT_PUBLIC_NODUS_ACCOUNTS=$NEXT_PUBLIC_NODUS_ACCOUNTS
RUN npm run build
EXPOSE 3000
CMD ["npm", "start"]
