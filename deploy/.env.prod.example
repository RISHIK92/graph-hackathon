# deploy/.env on the VM only (never committed). Tokens are generated there by the runbook:
#   sed -i "s/^PUBLIC_WRITE_TOKEN=.*/PUBLIC_WRITE_TOKEN=$(openssl rand -hex 24)/" .env   (and ADMIN_TOKEN)
BRAIN_DOMAIN=
PUBLIC_WRITE_TOKEN=
ADMIN_TOKEN=
# The OpenRouter demo key (about a $5 limit); the user adds it on the VM over SSH
OPENROUTER_API_KEY=
FALKOR_GRAPH=brain
# Models: the item 20 choice (arm C): DeepSeek planner and drafter on pinned endpoints, the Jev checker, no
# escalation. LLM_MODEL stays blank so the per-role models in brain/config.py apply.
LLM_MODEL=
BRAIN_LLM=on
BRAIN_CHECKER=on
BRAIN_ESCALATION=off
# Abuse limits: turns per client IP and hour, and model requests per UTC day (past it: the graph's own answers)
BRAIN_TURNS_PER_IP_HOUR=60
BRAIN_LLM_DAILY_CAP=3000
# Nightly reset to seed 1 (every 24 h from start, deferred while a token session is active)
BRAIN_SCHEDULED_RESET=on
BRAIN_RESET_EVERY_MIN=1440
BRAIN_SEED_DIR=world/seeds/1
EMBED_PROVIDER=local
EMBED_MODEL=local-hash-v1
EMBED_DIM=256

# Accounts and workspaces (item 24); keep off until the placeholders below are filled
NODUS_ACCOUNTS=off
NEXT_PUBLIC_NODUS_ACCOUNTS=off
NODUS_ACCOUNTS_GRAPH=nodus_accounts
NODUS_DEMO_EMAIL=
NODUS_DEMO_PASSWORD=
NODUS_UI_ORIGINS=https://nodus.example.com
NODUS_COOKIE_SECURE=on
# One graph per workspace: the source limit, and the shared demo workspace emptied nightly
NODUS_WS_MAX_SOURCES=2000
# How long an account's Ask history lasts, in minutes (resumes within it, starts fresh after)
NODUS_CHAT_TTL_MIN=60
NODUS_DEMO_NIGHTLY_RESET=on
# Connectors (item 24 step 4). Tokens people paste (Linear, GitHub, Jira) and Slack's OAuth token are stored
# encrypted with this key; without it no source can be connected. Generate: openssl rand -base64 32
NODUS_SECRET_KEY=
# The Slack app for "Connect with Slack" (placeholders; create the app at api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URL=
