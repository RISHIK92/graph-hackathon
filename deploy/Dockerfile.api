FROM python:3.13-slim
WORKDIR /app
COPY pyproject.toml ./
COPY brain ./brain
COPY api ./api
COPY ingest ./ingest
COPY mcp_server ./mcp_server
COPY world ./world
COPY evals ./evals
RUN pip install --no-cache-dir -e .
EXPOSE 8000 8765
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
