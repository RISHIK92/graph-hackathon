# FalkorDB
FALKOR_HOST=
FALKOR_PORT=
FALKOR_GRAPH=
FALKOR_PIN=
BRAIN_TIMEOUT_DEFAULT=
BRAIN_TIMEOUT_MAX=
# Models
OPENROUTER_API_KEY=
# Legacy single-model mode: when set, this one model plans, drafts and extracts (no fallbacks)
LLM_MODEL=
# Per-role models (item 20); blank = the default in brain/config.py ROLE_MODELS. _FALLBACK=none disables it,
# _PROVIDER pins an OpenRouter provider (planner, drafter, judge2)
MODEL_EXTRACTOR=anthropic/claude-haiku-5.5
MODEL_EXTRACTOR_FALLBACK=deepseek/deepseek-v4.1-flash
MODEL_SCREEN=typesafe/jev-1.14
MODEL_SCREEN_FALLBACK=nace-ai/drex-v2.0
MODEL_PLANNER=deepseek/deepseek-v4.1-flash
MODEL_PLANNER_FALLBACK=anthropic/claude-haiku-5.5
MODEL_PLANNER_PROVIDER=DeepInfra
MODEL_DRAFTER=deepseek/deepseek-v4.1-flash
MODEL_DRAFTER_FALLBACK=anthropic/claude-haiku-5.5
MODEL_DRAFTER_PROVIDER=DeepInfra
MODEL_ESCALATION=anthropic/claude-haiku-5.5
MODEL_CHECKER=typesafe/jev-1.14
MODEL_CHECKER_FALLBACK=nace-ai/drex-v2.0
MODEL_JUDGE=microsoft/microsoft-decision-1
MODEL_JUDGE_FALLBACK=openai/gpt-6-luna-decisions
MODEL_JUDGE2=nvidia/nemotron-3-ultra-550b-a55b
MODEL_JUDGE2_FALLBACK=z-ai/glm-5.2
MODEL_JUDGE2_PROVIDER=DeepInfra
# on|off: the live answer checker and its escalation redraft
BRAIN_CHECKER=on
# a fresh model cache for a cold-cache eval run
BRAIN_LLM_CACHE=
EMBED_PROVIDER=
EMBED_MODEL=
EMBED_DIM=
BRAIN_LLM=
BRAIN_EXTRACT_WORKERS=
BRAIN_EVAL_WORKERS=
# Engines and switches
PAST_BELIEF_ENGINE=
BRAIN_MCP_WRITES=
BRAIN_MCP_RISKY_WRITES=
BRAIN_MCP_ACTOR=
BRAIN_SEED_DIR=
BRAIN_SCHEDULED_RESET=
BRAIN_RESET_EVERY_MIN=
# Tokens
PUBLIC_WRITE_TOKEN=
ADMIN_TOKEN=
# Optional: POST each new proposal here (JSON)
BRAIN_PENDING_WEBHOOK=
# Tests
BRAIN_TEST_LLM=
SNAPSHOT_UPDATE=
# UI (ui/.env.local)
NEXT_PUBLIC_API_URL=
