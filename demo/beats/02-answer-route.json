{
  "name": "02-answer-route",
  "url": "http://localhost:3000/ask",
  "viewport": "desktop",
  "colorScheme": "dark",
  "reducedMotion": "no-preference",
  "timeout": 30000,
  "steps": [
    { "pause": 600 },
    { "waitFor": "testid=ask-input" },
    { "type": "Who owns Ledger?", "into": "testid=ask-input", "paste": true },
    { "click": "testid=ask-button" },
    { "waitFor": "text=Payments owns Ledger.", "pauseAfter": 1000 },
    { "click": { "find": "testid=citation-chip-1", "nth": 0 }, "pauseAfter": 1200 },
    { "click": { "find": "testid=how-i-answered", "nth": 0 }, "pauseAfter": 800 },
    { "click": "testid=proof-tab-cypher", "pauseAfter": 500 },
    { "click": { "find": "text=Show quer", "nth": -1 }, "zoom": 1.8, "pauseAfter": 2000 },
    { "type": "Route RDS-42 to the owner", "into": "testid=ask-input", "paste": true, "zoom": false },
    { "click": "testid=ask-button" },
    { "waitFor": "testid=switch-to-priya-raman", "pauseAfter": 1000 },
    { "click": "testid=switch-to-priya-raman", "pauseAfter": 800 },
    { "waitFor": "testid=confirm-button" },
    { "click": "testid=confirm-button", "pauseAfter": 600 },
    { "waitFor": "testid=confirm-modal-submit" },
    { "click": "testid=confirm-modal-submit", "pauseAfter": 1800 }
  ]
}
